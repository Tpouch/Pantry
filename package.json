{
  "name": "pantry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "pnpm --dir client run dev",
    "build": "pnpm --dir client run build",
    "start": "node server/index.js",
    "test": "pnpm --dir server run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3"
  }
}
